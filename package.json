{
  "name": "command-center",
  "version": "2.6.1",
  "description": "NOC event console with on-call teams and escalation for Dynatrace",
  "scripts": {
    "build": "dt-app build",
    "start": "dt-app dev",
    "create:function": "dt-app function create",
    "create:action": "dt-app action create",
    "uninstall": "dt-app uninstall",
    "deploy": "dt-app deploy",
    "update": "dt-app update",
    "info": "dt-app info",
    "help": "dt-app help",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc -p api/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && dt-app build"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dynatrace-sdk/app-environment": "^1.1.6",
    "@dynatrace-sdk/app-utils": "^1.0.2",
    "@dynatrace-sdk/client-automation": "^8.10.0",
    "@dynatrace-sdk/client-iam": "^1.1.0",
    "@dynatrace-sdk/client-query": "^1.29.0",
    "@dynatrace-sdk/client-state": "^1.11.1",
    "@dynatrace-sdk/navigation": "^2.3.2",
    "@dynatrace-sdk/react-hooks": "^1.15.4",
    "@dynatrace/strato-components": "^3.18.1",
    "@dynatrace/strato-design-tokens": "^1.8.1",
    "@dynatrace/strato-icons": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.2",
    "@dynatrace-sdk/automation-action-utils": "^0.43.0",
    "@dynatrace-sdk/client-app-settings-v2": "1.2.1",
    "@dynatrace/automation-action-components": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "dt-app": "^1.21.0",
    "eslint": "^9.37.0",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-security": "^3.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.2"
  }
}